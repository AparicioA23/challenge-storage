# Puerto HTTP del backend (el frontend de Vite usa el 3000)
PORT=4000

# Origen permitido por CORS (URL del frontend)
CORS_ORIGIN=http://localhost:3000

# Secreto para firmar los tokens HS256. Mínimo 32 caracteres.
# Generar con: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Vigencia del token en segundos (300 = 5 minutos)
TOKEN_TTL_SECONDS=300

# Marca la cookie del token como Secure. Chrome y Firefox la aceptan en http://localhost;
# Safari no, así que en Safari local usar false. En producción siempre true.
COOKIE_SECURE=true

# Credenciales del usuario de demostración
DEMO_USERNAME=
DEMO_PASSWORD=
